<!--
  本文件内容会被原样嵌入 AndroidManifest.xml 的 <manifest> 内部，
  不要包含 <?xml ...?> 声明，否则清单 XML 非法。
  注意：<service>/<activity> 等组件必须放在 <application> 内部，
  不能写在本文件里；无障碍服务的注入见 service_manifest_snippet.xml，
  由 CI 构建时补丁进 p4a 模板的 <application> 中。
-->

<!-- 前台保活服务所需权限（KeepAliveService）：
     FOREGROUND_SERVICE + WAKE_LOCK 保持后台可调度；
     POST_NOTIFICATIONS 用于 Android 13+ 的通知栏提示（拒绝也能运行）；
     FOREGROUND_SERVICE_SPECIAL_USE 为 Android 14+ specialUse 类型所需。 -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<uses-permission android:name="android.permission.WAKE_LOCK" />

<!-- Android 11+（API 30+）包可见性声明：
     不声明的话 getLaunchIntentForPackage("com.moutai.mall") 返回 null -->
<queries>
    <package android:name="com.moutai.mall" />
</queries>
