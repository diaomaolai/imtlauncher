<!--
  无障碍服务清单片段。
  p4a 的 extra manifest xml 参数内容只能插入到 manifest 节点下，
  service 组件必须位于 application 内部，直接放会报清单错误。
  本片段由 GitHub Actions 构建时注入 p4a 的
  AndroidManifest.tmpl.xml 的 application 结束标签之前（见 workflow）。
  BIND_ACCESSIBILITY_SERVICE 为签名级权限，写在组件上；
  用户需手动到 设置、无障碍 中开启一次。
  注意：本注释内禁止出现连续两个减号，否则 XML 非法。
-->
<service
    android:name="org.personal.imtlauncher.MtA11yService"
    android:exported="false"
    android:label="i茅台启动器无障碍服务"
    android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
    <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
    </intent-filter>
    <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/imt_a11y_config" />
</service>

<!--
  前台保活服务：定时抢购期间防止进程被 ROM 冻结
  （ColorOS/EMUI 后台冻结会让 FlowWorker 停摆）。
  targetSdk 33 不强制声明 foregroundServiceType（强制要求从 targetSdk 34 起），
  故不指定类型：compileSdk 33 的 AAPT 不识别 API34 才有的 specialUse，
  写了会在资源链接阶段直接报错，而非运行时忽略。
  对应权限声明在 extra_manifest.xml。
-->
<service
    android:name="org.personal.imtlauncher.KeepAliveService"
    android:exported="false" />
